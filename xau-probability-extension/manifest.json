{
  "manifest_version": 3,
  "name": "Jenvu — XAU/USD Probability Engine",
  "version": "2.0.0",
  "description": "ICT/SMC Gold regime, BUY/SELL/WAIT probabilities, trade plan and next three candle outlook.",
  "permissions": ["storage"],
  "host_permissions": ["https://query1.finance.yahoo.com/*"],
  "action": { "default_popup": "popup.html", "default_title": "Jenvu Gold Probability" },
  "icons": { "48": "icon.png", "128": "icon.png" },
  "content_scripts": [{
    "matches": ["https://*.tradingview.com/*"],
    "js": ["engine.js", "content.js"],
    "css": ["panel.css"],
    "run_at": "document_idle"
  }],
  "background": { "service_worker": "background.js" }
}
