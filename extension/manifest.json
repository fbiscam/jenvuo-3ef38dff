{
  "manifest_version": 3,
  "name": "Jenvu TradingView Marker",
  "version": "0.1.0",
  "description": "Auto-mark Jenvu ICT/SMC signals on TradingView charts. Voice + one-click open.",
  "permissions": ["storage", "tabs", "activeTab"],
  "host_permissions": ["https://*.tradingview.com/*", "https://jenvu.com/*", "https://*.lovable.app/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png",
    "default_title": "Jenvu TradingView Marker"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.tradingview.com/chart/*", "https://*.tradingview.com/chart*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "48": "icon.png", "128": "icon.png" }
}
