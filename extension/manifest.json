{
  "manifest_version": 3,
  "name": "Jenvu · TradingView Auto-Draw",
  "version": "1.0.0",
  "description": "Auto-draws Entry, Stop-Loss and Take-Profit on TradingView whenever a Jenvu signal fires.",
  "permissions": ["storage", "alarms", "tabs", "scripting", "notifications"],
  "host_permissions": [
    "https://www.tradingview.com/*",
    "https://tradingview.com/*",
    "https://jenvu.com/*",
    "https://*.lovable.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Jenvu",
    "default_icon": { "16": "icon.png", "48": "icon.png", "128": "icon.png" }
  },
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icon.png", "48": "icon.png", "128": "icon.png" },
  "content_scripts": [
    {
      "matches": ["https://www.tradingview.com/chart/*", "https://tradingview.com/chart/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
